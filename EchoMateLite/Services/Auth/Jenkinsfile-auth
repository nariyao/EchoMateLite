@Library ("EchoMateLite@services") _

pipeline {
    agent any
    tools {
        nodejs "22.14"
    }
    environment {
        PROJECT_NAME = 'EchoMateLite'
        BUILD_NUMBER = "${env.BUILD_ID}"
        PRJECT_PREFIX = "eml"
        AWS_ARTIFACTS_BUCKET = "eml-artifacts-bucket"
        AWS_REGION = "us-east-1"
        AUTH_DIR = "EchoMateLite/Services/Auth"
        LAMBDA_DIR = "aws_lambda_auth"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                dir("${AUTH_DIR}") {
                    script {
                        sh """
                            echo "installing dependencies..."
                            cd ${LAMBDA_DIR}
                            npm install
                            echo "installing dependencies done..."
                            echo "creating zip file..."
                            zip -r ../${LAMBDA_DIR}.zip ./*
                            echo "creating zip file done..."
                        """
                    }
                }
            }
        }
        stage('Upload to S3') {
            steps {
                sh "aws s3 cp ${AUTH_DIR}/${LAMBDA_DIR}.zip s3://${AWS_ARTIFACTS_BUCKET}/Services/Auth/${LAMBDA_DIR}.zip --region ${AWS_REGION}"
            }
        }
        stage('Validate Templates') {
            parallel {
                stage('Auth CFN') {
                    steps {
                        script {
                            isCFNTemplateValid("${AUTH_DIR}", 'Auth_CFN.yml')
                        }
                    }
                }
                stage('Cognito CFN') {
                    steps {
                        script {
                            isCFNTemplateValid("${AUTH_DIR}", 'Cognito_CFN.yml') 
                        }
                    }
                }
            }
        }
        stage('Deploy') {
            steps{
                echo "Deploying Cognito CFN Stack..."
                deployCFNStack('./EchoMateLite/Services/Auth', 'Cognito-CFN', 'Cognito_CFN.yml', 'parameters/Cognito_CFN_Parameters.json')
                echo "Deploying Cognito CFN Stack done..."
                echo "Deploying Auth CFN Stack..."
                deployCFNStack('./EchoMateLite/Services/Auth', 'Auth-CFN', 'Auth_CFN.yml', 'parameters/Auth_CFN_Parameters.json')
                echo "Deploying Auth CFN Stack done..."
            }
        }
        stage("Post-Deployment Validation") {
            parallel {
                stage("Varify Cognito CFN"){
                    steps{
                        echo "Post deployment varification for Cognito CFN..."
                        script {
                            def stackName = "${env.PROJECT_PREFIX}-Cognito-CFN"
                            def result = sh(script: "aws cloudformation describe-stacks --stack-name ${stackName} --query 'Stacks[0].StackStatus' --output text", returnStdout: true).trim()
                            if (result != 'CREATE_COMPLETE' && result != 'UPDATE_COMPLETE') {
                                error("Post deployment validation failed for stack ${stackName}. Current status: ${result}")
                            } else {
                                echo "Post deployment validation successful for stack ${stackName}. Current status: ${result}"
                            }
                        }
                    }
                }
                stage("Varify Auth CFN"){
                    steps{
                        echo "Post deployment varification for Auth CFN..."
                        script {
                            def stackName = "${env.PROJECT_PREFIX}-Auth-CFN"
                            def result = sh(script: "aws cloudformation describe-stacks --stack-name ${stackName} --query 'Stacks[0].StackStatus' --output text", returnStdout: true).trim()
                            if (result != 'CREATE_COMPLETE' && result != 'UPDATE_COMPLETE') {
                                error("Post deployment validation failed for stack ${stackName}. Current status: ${result}")
                            } else {
                                echo "Post deployment validation successful for stack ${stackName}. Current status: ${result}"
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Cleaning up..."
                deleteDir()
            }
        }
        success {
            script {
                echo "Build completed successfully!"
            }
        }
        failure {
            script {
                echo "Build failed!"
            }
        }
    }
}