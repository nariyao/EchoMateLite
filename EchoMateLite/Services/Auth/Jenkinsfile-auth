
pipeline{
    agent any
    environment {
        // Define any environment variables here
        PROJECT_NAME = 'EchoMateLite'
        BUILD_NUMBER = "${env.BUILD_ID}"
        PRJECT_PREFIX =  "eml"
    }
    stages{
        stage('Checkout'){
            steps{
                script{
                    echo "Checking out the code..."
                    checkout scm
                }
            }
        }
        stage('Build'){
            steps{
                dir("EchoMateLite/Services/Auth") {
                    echo "Building the project..."
                    script{
                        npm install 
                    }
                }
            }
        }
        stage('Validate CloudFormation Template'){
            parallel {
                stage('Validate Cognito CFN'){
                    steps{
                        script{
                            isAWS_CFN_Vaild('EchoMateLite/Services/Auth', 'Auth_CFN.yml')
                        }
                    }
                }
                stage('Validate Cognito CFN'){
                    steps{
                        script{
                            isAWS_CFN_Vaild('EchoMateLite/Services/Cognito', 'Cognito_CFN.yml')
                        }
                    }
                }
            }
        }
        stage('Test'){
            steps{
                script{
                    echo "Running tests..."
                }
            }
        }
        stage('Deploy'){
            steps{
                script{
                    echo "Deploying the project..."
                }
            }
        }
    }
}