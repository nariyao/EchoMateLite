@Library ("EchoMateLite") _

pipeline {
    agent any
    tools {
        nodejs "22.14"
    }
    environment {
        PROJECT_NAME = 'EchoMateLite'
        BUILD_NUMBER = "${env.BUILD_ID}"
        PRJECT_PREFIX = "eml"
        AWS_ARTIFACT_BUCKET_NAME = "eml-artifact-bucket"
        AWS_REGION = "us-east-1"
        AUTH_DIR = "EchoMateLite/Services/Auth"
        LAMBDA_DIR = "aws_lambda_auth"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                dir("${AUTH_DIR}") {
                    script {
                        sh """
                            echo "installing dependencies..."
                            cd ${LAMBDA_DIR}
                            npm install
                            echo "installing dependencies done..."
                            echo "creating zip file..."
                            zip -r ../${LAMBDA_DIR}.zip ./*
                            echo "creating zip file done..."
                        """
                    }
                }
            }
        }
        stage('Upload to S3') {
            steps {
                sh "aws s3 cp ${AUTH_DIR}/${LAMBDA_DIR}.zip s3://${AWS_BUCKET_NAME}/Services/Auth/${LAMBDA_DIR}.zip --region ${AWS_REGION}"
            }
        }
        stage('Validate Templates') {
            parallel {
                stage('Auth CFN') {
                    steps {
                        script {
                            isCFNTemplateVaild("${AUTH_DIR}", 'Auth_CFN.yml')
                        }
                    }
                }
                stage('Cognito CFN') {
                    steps {
                        script {
                            isCFNTemplateVaild("${AUTH_DIR}", 'Cognito_CFN.yml') 
                        }
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                echo "Deploying the project..."
            }
        }
    }

    post {
        always {
            script {
                echo "Cleaning up..."
                deleteDir()
            }
        }
        success {
            script {
                echo "Build completed successfully!"
            }
        }
        failure {
            script {
                echo "Build failed!"
            }
        }
    }
}