pipeline{
    agent any
    environment {
        // Define any environment variables here
        PROJECT_NAME = 'EchoMateLite'
        BUILD_NUMBER = "${env.BUILD_ID}"
        PRJECT_PREFIX =  "eml"
    }
    stages{
        stage('Build'){
            steps{
                script{
                    echo "Building the project..."
                    echo "Project Name: ${PROJECT_NAME}"
                    echo "Build Number: ${BUILD_NUMBER}"
                    echo "Project Prefix: ${PRJECT_PREFIX}"
                }
            }
        }
        stage('Test'){
            steps{
                script{
                    echo "Running tests..."
                }
            }
        }
        stage('Deploy'){
            steps{
                script{
                    echo "Deploying the project..."
                }
            }
        }
    }
}