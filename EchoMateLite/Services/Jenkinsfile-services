                        """
                    }
                }
                stage('Validating Services_CFN'){
                    steps{
                        echo 'Start: Validating the CloudFormation template...'
                        sh """
                            echo 'Validating Services_CFN'
                            aws cloudformation validate-template --template-body file://Services_CFN.yml
                        """
                    }
                }
            }
        }
