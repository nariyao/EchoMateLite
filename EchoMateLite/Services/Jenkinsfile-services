pipeline{
    agent any
    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
    }
    stages{
        stage('Checkout'){
            steps{
                echo 'Start: Checkout the repository...'
                sh "pwd"
                sh """
                    git checkout Services
                """
                sh "cd EchoMateLite/Services/"
            }
        }
        stage('Validating CloudFormation Template'){
            parallel {
                stage('Validating Services_Roles_CFN'){
                    steps{
                        echo 'Start: Validating the CloudFormation template...'
                        sh """
                            echo 'Validating Services_Roles_CFN'
                            aws cloudformation validate-template --template-body file://Services_Roles_CFN.yml
                        """
                    }
                }
                stage('Validating DynamoDB_CFN'){
                    steps{
                        echo 'Start: Validating the CloudFormation template...'
                        sh """
                            echo 'Validating DynamoDB_CFN'
