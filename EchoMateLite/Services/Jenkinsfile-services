// Function to validate CloudFormation template
def isCFNTemplateValid(templatePath, templateName) {
        echo "Validating CloudFormation template: ${templateName}"
        dir(templatePath) {
            // Check if the template file exists
            if (!fileExists(templateName)) {
                error("CloudFormation template ${templateName} does not exist in path ${templatePath}")
                return false
            }
            def result = sh(script: "aws cloudformation validate-template --template-body file://${templateName}", returnStatus: true)
            if (result != 0) {
                error("CloudFormation template validation failed for ${templateName}")
                return false
            }
        }
        return true
    }

// Function to wait for stack operation to complete
def waitForStackOperation(stackName) {
    echo "Waiting for stack ${stackName} operation to complete..."
    def status = ''
    def count = 0
    def maxAttempts = 60 // 30 minutes timeout (60 * 30 seconds)
    
    while (count < maxAttempts) {
        def result = sh(script: "aws cloudformation describe-stacks --stack-name ${stackName} --query 'Stacks[0].StackStatus' --output text", returnStdout: true).trim()
        status = result
        echo "Current stack status: ${status}"
        if (status.endsWith('COMPLETE')) {
            if (status == 'CREATE_COMPLETE' || status == 'UPDATE_COMPLETE') {
                echo "Stack ${stackName} operation completed successfully"
                return true
            } else if (status == 'ROLLBACK_COMPLETE' || status == 'UPDATE_ROLLBACK_COMPLETE') {
                error("Stack ${stackName} operation failed and rolled back")
                return false
            }
        } else if (status.endsWith('FAILED')) {
            error("Stack ${stackName} operation failed with status: ${status}")
            return false
        }
        
        sleep 30 // Wait 30 seconds before next check
        count++
    }
    
    error("Timeout waiting for stack ${stackName} operation to complete")
    return false
}

def deleteCFNStack(stackName) {
    echo "Deleting CloudFormation stack: ${stackName}"
    def result = sh(script: "aws cloudformation delete-stack --stack-name ${stackName}", returnStatus: true)
    if (result != 0) {
        error("CloudFormation stack deletion failed for ${stackName}")
        return false
    }
    
    // Wait for stack deletion to complete
    return waitForStackOperation(stackName)
}

// Updated deployCFNStack function with wait condition
def deployCFNStack(templatePath, stackName, templateName, parametersFile='Parameters.yml', iamCapabilities = '') {


    // Check if the template file exists and validate it
    dir(templatePath) {
        // Check if the template file exists
        if (!fileExists(parametersFile)) {
                error("Parameters file ${parametersFile} does not exist in path ${templatePath}")
                return false
        }
        echo "Deploying CloudFormation stack: ${stackName}"
        def newStackName = "${env.PROJECT_PREFIX}-${stackName}"
        def capabilities = iamCapabilities ? "--capabilities ${iamCapabilities}" : ''
        def result = sh(script: "aws cloudformation describe-stacks --stack-name ${newStackName}", returnStatus: true)
        if (result == 0) {
            echo "Stack ${newStackName} already exists. Updating the stack..."
            result = sh(script: "aws cloudformation update-stack --stack-name ${newStackName} --template-body file://${templateName} --parameters file://${parametersFile} ${capabilities}", returnStatus: true)
            echo "Stack ${newStackName} does not exist. Creating the stack..."
            result = sh(script: "aws cloudformation create-stack --stack-name ${newStackName} --template-body file://${templateName} --parameters file://${parametersFile} ${capabilities}", returnStatus: true)
        }
        if (result != 0) {
            deleteCFNStack(newStackName) // Attempt to delete the stack if deployment fails
            error("CloudFormation stack deployment failed for ${newStackName}")
            return false
        }
        
        // Wait for stack operation to complete
        return waitForStackOperation(newStackName)
    }
}


pipeline{
    agent any
    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        PROJECT_NAME = 'EchoMateLite'
        PROJECT_PREFIX = 'Eml'
    }
    stages{
        stage('Check Directory') {
            steps {
                sh '''
                    echo "Checking if EchoMateLite/Services directory exists..."
                    if [ -d ./EchoMateLite/Services ]; then
                        echo "Directory exists!"
                        ls -l ./EchoMateLite/Services
                    else
                        echo "Directory does not exist."
                        exit 1
                    fi
                '''
            }
        }
        stage('Validating CloudFormation Template'){
            parallel {
                stage('Validating Services Roles CFN'){
                    steps{
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            isCFNTemplateValid('./EchoMateLite/Services', 'Services_Roles_CFN.yml')
                        }
                    }
                }
                stage('Validating DynamoDB CFN'){
                    steps{
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            isCFNTemplateValid('./EchoMateLite/Services', 'DynamoDB_CFN.yml')
                        }
                    }
                }
                stage('Validating Services CFN'){
                    steps{
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            isCFNTemplateValid('./EchoMateLite/Services', 'Services_CFN.yml')
                        }
                    }
                }
            }
        }
        stage('Deploying the CFN Stack'){
            steps{
                echo "Deploying DynamoDB"
                deployCFNStack('./EchoMateLite/Services', 'DynamoDB-CFN', 'DynamoDB_CFN.yml', 'Parameters/DynamoDB_CFN_Parameters.json')
            }
        }
        stage("Deploying Services"){
            steps{
                echo "Deploying Services CFN Stack..."
                deployCFNStack('./EchoMateLite/Services', 'Services-CFN', 'Services_CFN.yml', 'Parameters/Services_CFN_Parameters.json')
            }
        }
        stage("Deploying Services Roles"){
            steps{
                echo "Deploying Services Roles CFN Stack..."
                deployCFNStack('./EchoMateLite/Services', 'Services-Roles-CFN', 'Services_Roles_CFN.yml', 'Parameters/Services_Roles_CFN_Parameters.json', 'CAPABILITY_NAMED_IAM')
            }
        }
        stage("Post deployment validation"){
            parallel {
                stage("Post deployment validation for Services Roles CFN"){
                    steps{
                        echo "Post deployment validation for Services Roles CFN..."
                        script {
                            def stackName = "${env.PROJECT_PREFIX}-Services-Roles-CFN"
                            def result = sh(script: "aws cloudformation describe-stacks --stack-name ${stackName} --query 'Stacks[0].StackStatus' --output text", returnStdout: true).trim()
                            if (result != 'CREATE_COMPLETE' && result != 'UPDATE_COMPLETE') {
                                error("Post deployment validation failed for stack ${stackName}. Current status: ${result}")
                            } else {
                                echo "Post deployment validation successful for stack ${stackName}. Current status: ${result}"
                            }
                        }
                    }
                }
                stage("Post deployment validation for Services CFN"){
                    steps{
                        echo "Post deployment validation for Services CFN..."
                        script {
                            def stackName = "${env.PROJECT_PREFIX}-Services-CFN"
                            def result = sh(script: "aws cloudformation describe-stacks --stack-name ${stackName} --query 'Stacks[0].StackStatus' --output text", returnStdout: true).trim()
                            if (result != 'CREATE_COMPLETE' && result != 'UPDATE_COMPLETE') {
                                error("Post deployment validation failed for stack ${stackName}. Current status: ${result}")
                            } else {
                                echo "Post deployment validation successful for stack ${stackName}. Current status: ${result}"
                            }
                        }
                    }
                }
                stage("Post deployment validation for DynamoDB CFN"){
                    steps{
                        echo "Post deployment validation for DynamoDB CFN..."
                        script {
                            def stackName = "${env.PROJECT_PREFIX}-DynamoDB-CFN"
                            def result = sh(script: "aws cloudformation describe-stacks --stack-name ${stackName} --query 'Stacks[0].StackStatus' --output text", returnStdout: true).trim()
                            if (result != 'CREATE_COMPLETE' && result != 'UPDATE_COMPLETE') {
                                error("Post deployment validation failed for stack ${stackName}. Current status: ${result}")
                            } else {
                                echo "Post deployment validation successful for stack ${stackName}. Current status: ${result}"
                            }
                        }
                    }
                }
            }
        }
    }
}
