// Jenkinsfile for validating CloudFormation templates in the EchoMateLite/Services directory
def isCFNTemplateValid(templatePath, templateName) {
    dir(templatePath) {
        echo "Validating CloudFormation template: ${templateName}"
        def result = sh(script: "aws cloudformation validate-template --template-body file://${templateName}", returnStatus: true)
        return result == 0
    }
}



